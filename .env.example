# Copy to .env, chmod 600 .env, and edit locally. Never commit secrets.
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName from your own eBay developer keyset; not a URL.
EBAY_REDIRECT_URI=
EBAY_USER_REFRESH_TOKEN=
EBAY_READ_ONLY=true
EBAY_ALLOW_WRITES=false
EBAY_MCP_ALLOWED_WRITE_TOOLS=
EBAY_MCP_TOOLS=inventory,metadata,taxonomy,stores
EBAY_MCP_REDACT_PII=true
EBAY_MCP_CHECK_UPDATES=false
EBAY_MCP_ALLOW_BINARY_EXPORTS=false
EBAY_LOG_BODIES=false
EBAY_ENABLE_FILE_LOGGING=false
EBAY_LOG_LEVEL=info
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CONTENT_LANGUAGE=en-US
# Default OAuth scopes are basic + inventory.readonly + stores.readonly.
# Add scopes only when actually needed and granted to your own keyset.
# EBAY_OAUTH_SCOPES=
MCP_HOST=127.0.0.1
# HTTP optional: OAuth must be configured or MCP_AUTH_TOKEN must have >=32 characters.
# MCP_AUTH_TOKEN=
